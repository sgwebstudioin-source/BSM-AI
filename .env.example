# Gemini API key for live AI volatility forecasts.
# Without this, the app runs in demo mode with deterministic baselines.
VITE_API_KEY=your-gemini-api-key-here

# Firebase Web App config (alternative to dropping a firebase-config.json
# file into ./src). All five fields below are required to enable Google
# sign-in + Firestore persistence.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
